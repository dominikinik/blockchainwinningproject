{
  "name": "SLAna monorepo",

  "build": {
    "dockerfile": "../Dockerfile",
    "target": "toolchain",
    "context": "..",
    "options": {
      "platform": "linux/amd64"
    }
  },

  // The Dev Containers CLI inspects the Dockerfile's base image before building,
  // pulling it for the host platform and ignoring `FROM --platform` and the
  // build `platform` option. The OtterSec image is amd64-only, so on Apple
  // Silicon that pull fails with "no matching manifest for linux/arm64/v8".
  // Pre-pulling the amd64 variant lets the CLI find it locally.
  "initializeCommand": "docker pull --platform linux/amd64 quay.io/ottersec/anchor:v1.1.2",

  "remoteUser": "root",

  "remoteEnv": {
    "LIVE_ROOT": "${containerWorkspaceFolder}"
  },

  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "forwardPorts": [8899, 5173],
  "portsAttributes": {
    "8899": { "label": "Surfpool RPC", "onAutoForward": "silent" },
    "5173": { "label": "SLAna frontend", "onAutoForward": "notify" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        // Rust & Cargo
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb",
        "fill-labs.dependi",

        // TypeScript & Web
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "christian-kohler.path-intellisense",

        // Infrastructure & Docker
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",

        // System Monitoring & Quality of Life
        "mutantdino.resourcemonitor",
        "usernamehw.error-lens",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "streetsidesoftware.code-spell-checker",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.procMacro.enable": true,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        },
        "errorLens.enabled": true,
        "resourcemonitor.cpu.enable": true,
        "resourcemonitor.memory.enable": true,
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        }
      }
    }
  },

  "mounts": [
    "source=live-cargo-registry,target=/root/.cargo/registry,type=volume",
    "source=live-npm-cache,target=/root/.npm,type=volume"
  ]
}
